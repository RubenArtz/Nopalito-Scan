<!--
  Project-wide lint configuration.

  UnsafeOptInUsageError / androidx.camera.core.ExperimentalGetImage:
  `ImageProxy.getImage()` (used in CameraViewModel.analyzeQrFrame) is marked
  with androidx's ExperimentalGetImage marker, but that marker is NOT annotated
  with kotlin @RequiresOptIn -- the Kotlin compiler itself requires no opt-in
  (it compiles clean without any annotation), so the Kotlin `@OptIn` form has
  no effect and only lint's androidx.annotation.experimental check flags it.
  The usage is safe: the null case is handled explicitly right after the call
  (imageProxy.close() + early return). Project-wide opt-in is the documented
  mechanism for exactly this case (see the lint explanation for this check).

  IconLocation / res/drawable/icon.png:
  UI-only icon (About screen, 88.dp with rounded clip), NOT the launcher icon
  (the manifest uses @mipmap/ic_launcher). It is a raster logo rendered at a
  fixed dp size, so moving it to drawable-nodpi would change its visual size
  on different screen densities, and drawable-mdpi would be misleading; a
  single densityless copy is intentional. Kept in place with this ignore.
-->
<lint>
    <issue id="UnsafeOptInUsageError">
        <option name="opt-in" value="androidx.camera.core.ExperimentalGetImage"/>
    </issue>
    <issue id="IconLocation">
        <ignore path="res/drawable/icon.png"/>
    </issue>
</lint>