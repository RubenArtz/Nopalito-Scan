<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Haptic feedback: normal permission, auto-granted; needed for the direct
         Vibrator fallback on API 26-29 (the system haptics path needs none). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- QR WiFi connect: network suggestions need a nearby/location runtime permission -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Required (on Android 9 and lower) to save files -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- To download Tesseract language data -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- For network state checking (cloud module) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ (API 33+): show push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Google Play Billing — no extra runtime permission needed, but explicit declaration ensures manifest merger -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <application
        android:name=".NopalitoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NopalitoScan"
        tools:targetApi="tiramisu">
        <!-- Push notifications (FCM): default channel used by FCM notifications
             when no channel id is specified in the message. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="push_general" />

        <!-- FCM message service. It handles tokens (onNewToken → register with
             the backend) and foreground notifications. No Firebase secret is
             stored in the app: everything server-side. -->
        <service
            android:name=".push.NopalitoScanMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NopalitoScan"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="nopalito.app.action.SCAN_TO_PDF" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>