<paths>
    <cache-path
            name="pdfs"
            path="pdfs/"/>
    <!-- temp camera captures (used by imported signature camera flow) -->
    <cache-path
            name="temp_images"
            path="temp_images/"/>
    <external-path
            name="external_files"
            path="."/>
    <!-- source images (to send the last captured image) -->
    <files-path
            name="sources"
            path="sources/"/>
    <!-- private backup of exported files (history preview/share) -->
    <files-path
            name="exports_backup"
            path="exports_backup/"/>
    <!-- materialized exported files for sharing/download when no backup exists -->
    <cache-path
            name="history_export_tmp"
            path="history_export_tmp/"/>
    <!-- cloud cached files (preview/share) -->
    <files-path
            name="cloud_cache"
            path="cloud_cache/"/>
    <!-- source images, when scanning via Intent (to send the last captured image) -->
    <cache-path
            name="session_sources"
            path="sessions/"/>
    <!-- Tools: temporary files for compression (input/output/cloud upload) -->
    <cache-path
            name="tools"
            path="tools/"/>
    <!-- QR generator: temp files written before sharing -->
    <cache-path
            name="qr_generated"
            path="qr_generated/"/>
</paths>
