<network-security-config>
    <!-- Block cleartext and trust system CAs for every domain -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>